  "decision": {
    "margin": 0.05,
    "b0_minus_best_other_false_safe": 0.014204545454545442,
    "b0_minus_best_other_ranking_regret": 0.1,
    "verdict": "inconclusive_neither_branch_triggered",
    "metric_b_resolution": 0.05,
    "margin_cannot_resolve_one_context": true,
    "pre_registration_defect": "The registered margin and the ranking metric's own resolution are both one context in twenty. A margin equal to the smallest difference the metric can express cannot separate signal from a single context changing hands, so the metric-B branch of the rule was unresolvable by construction. This is a flaw in the pre-registration, not in the data; it is recorded rather than corrected after the fact. A future block wanting to decide on this metric needs either more held-out contexts or a margin of at least two contexts, set before collection.",
    "rule": {
      "margin": 0.05,
      "margin_units": "absolute, on both metrics",
      "metric_a": "Held-out false-safe rate: of the actions a predictor calls safe, the fraction that actually lost the clip, evaluated at matched coverage with B0.",
      "metric_b": "Held-out action-ranking regret. In each test context the supervisor considers the twelve shared core actions, keeps those its predictor calls safe, and issues the one with the largest commanded displacement magnitude, because a larger clearance is the more useful repair; ties break in registered order. Regret is the fraction of test contexts whose issued action actually lost the clip. Contexts where a predictor calls no action safe are counted separately as abstentions and are not scored as regret.",
      "metric_b_secondary": "The same procedure scored on the secondary label instead: the fraction of test contexts whose issued action did not reach held, clip-preserving seating. Reported beside metric B so a predictor that is safe but useless cannot pass as a win.",
      "predicted_safe_set": "For B1 and M, predicted probability of clip loss below 0.5. For B0, the fitted threshold rule itself.",
      "wrap_up_if": "B0 is within the margin of the best of B1 and M on both metrics. Meaning the safe boundary is a one-dimensional physical budget, engineering already solves it, and learning cannot justify its data cost here.",
      "continue_if": "M beats both B0 and B1 by more than the margin on both metrics, and that advantage survives into closed-loop clip-preserving completion at matched cost.",
      "conflict": "Better prediction with no closed-loop gain is reported plainly as such and is not presented as a win.",
      "pre_registered": "This rule, the margin, the metrics, the group split and the full request list were frozen in this file and committed before any request was launched."
    }
  },
  "scope_and_limitations": [
    "Simulation only. No hardware access, connector transfer, released retention or force-certified safety claim.",
    "Fixed preset grasp is a disclosed construction boundary; grasp strength and drop robustness are not measured.",
    "Every arm and every predictor reads simulator state, not camera perception.",
    "Bracket compliance is translational only; bracket rotation, backlash and hysteresis are not modelled.",
    "Cable discretisation insensitivity is not established: the 46-segment control fails at every integration rate tested.",
    "Peak contact sums move about 70 percent between physics resolutions and must never be quoted as resolution-independent."
  ],
