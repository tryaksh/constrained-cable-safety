 "status": "recorded_decision_states",
 "what_this_is": "Three recorded estimates, one per declared error level, taken at the FIRST repair decision of the registered five-clip job RC1_l15_compliant4000_m0_<level>_conservative_r0. They exist so scripts/try_the_safety_check.py can show the shipped safety layer deciding a real move without a simulator installed. Not a study result and not a new measurement.",
 "why_it_is_committed": "The safety layer needs numpy and nothing heavier, but the state it judges comes out of MuJoCo. Committing three states is what makes the check runnable on a plain checkout. Each one is the state the block itself held at that decision, not a reconstruction.",
 "how_it_was_taken": "scripts/evaluate_cable_routing_v6.run_case was run on the registered request expanded by cable_workbench_v7.WorkbenchSession, and the first dict returned by evaluate_cable_perception_v4.observed_decision_state was kept. Only the fields the filter and this demonstration read are stored; the estimated 24-point centreline and the occlusion weights are not, because no rule here reads them.",
 "cross_check": {
  "what": "The C1 headroom these states imply must equal the headroom the committed job result recorded at its first decision, to nine decimal places.",
  "record": "artifacts/showcase/tool.json",
  "field": "checks[2].expected.c1_headroom_series_m[0]",
  "checked_by": "scripts/try_the_safety_check.py, on every run"
 },
 "scope": "One rig, one service loop, one port mount, one mounting offset, one repeat, and the first decision of each. What the fitted rule allows from geometry, which is not what the physics permits: the study's held-out false-approval rate is the measure of how often those differ. Simulation only; no hardware claim.",
 "safety_filter": {
  "fit": "evidence/cable_perception_v4.json",
  "contract": "configs/cable_perception_v4.json",
  "base": "configs/cable_recovery_task_v2.json",
  "arm": "B0plus, the analytic budget carrying a margin sized from the declared estimator covariance",
  "fitted_on": "single-clip layouts. It has never seen a five-clip rig, which is the point."
 },
