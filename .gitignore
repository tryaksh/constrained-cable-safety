.deps/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest_tmp*/
.ruff_cache/
.coverage
htmlcov/
.idea/
.vscode/

# Simulator and renderer output. Gigabytes of trajectories, frames and stages.
#
# `artifacts/*` and not `artifacts/`, because **git cannot re-include anything
# inside an excluded directory**. This said `artifacts/` for months, which
# silently defeated every exception below it: the stage records were never
# committed, and the README linked to five of them anyway, so a clone got five
# dead links and the only copy of those records lived on one workstation.
# Excluding the contents rather than the directory is what makes an exception
# possible at all, and each level has to be reopened the same way.
artifacts/*
!artifacts/cell/
artifacts/cell/*
!artifacts/cell/*.json
!artifacts/cell/*.md
!artifacts/showcase/
artifacts/showcase/*
# The small records only: what was checked, what it produced, what it cost. Not
# the generated page, the frames, the encoded video or the USD stage.
!artifacts/showcase/*.json
!artifacts/showcase/*.md
benchmarks/*.json
outputs/
logs/
checkpoints/
datasets/
videos/
wandb/
runs/
*.pt
*.pth
*.onnx
*.hdf5
*.mp4

# Local machine state
environment-lock.local.json
*.local.ps1

# Per-machine coding-agent settings.
.claude/settings.local.json
MUJOCO_LOG.TXT
